# Local development environment variables
# Copy this file to .dev.vars and update with your actual values
# .dev.vars is in .gitignore and won't be committed

# ntfy topic for push notifications (https://ntfy.sh)
# Used for sending jackpot alerts when thresholds are crossed
# The topic name acts as the credential — pick something unguessable and keep it secret
NTFY_TOPIC=lottocheck-alerts-CHANGE-ME
