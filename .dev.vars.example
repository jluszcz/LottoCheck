# Local development environment variables
# Copy this file to .dev.vars and update with your actual values
# .dev.vars is in .gitignore and won't be committed

# Email configuration for Cloudflare Email Service notifications
# These are used for sending jackpot alerts when thresholds are crossed
# FROM_EMAIL must use a domain onboarded to Email Sending on your Cloudflare account
FROM_EMAIL=alerts@yourdomain.com
TO_EMAIL=your-email@example.com
